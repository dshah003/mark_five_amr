FROM ros:melodic

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Basic tools
RUN apt-get update && \
    apt-get install vim nano git tmux wget curl python-pip net-tools iputils-ping  -y

RUN apt-get update && \
    apt-get install -y ros-melodic-rosbridge-server \
    ros-melodic-joy \
    ros-melodic-rosserial-arduino \
    ros-melodic-rosserial \
    ros-melodic-teleop-twist-keyboard \
    ros-melodic-teleop-twist-joy \
    ros-melodic-rviz \
    ros-melodic-urdf \
    ros-melodic-xacro \
    ros-melodic-navigation \
    ros-melodic-joint-state-publisher \
    ros-melodic-joint-state-publisher-gui \
    ros-melodic-robot-state-publisher

# Intel RealSense camera and depth-to-laserscan packages
RUN apt-get update && \
    apt-get install -y ros-melodic-realsense2-camera \
    ros-melodic-realsense2-description \
    ros-melodic-depthimage-to-laserscan \
    ros-melodic-rgbd-launch \
    ros-melodic-image-transport \
    ros-melodic-image-transport-plugins

RUN apt-get update && \
    apt-get install liburdfdom-tools

# Add ros sourcing to bashrc
RUN echo ". /opt/ros/melodic/setup.bash" >> ~/.bashrc

ARG HOME
ENV MARKY_ROOT="${HOME}/mark_five_amr/"

WORKDIR ${HOME}

HEALTHCHECK --interval=5m --timeout=3s CMD echo "Mark Five: I'm alive!" || exit 1
CMD ["/bin/bash"]