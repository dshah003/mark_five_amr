# Mark Five AMR - ROS2 Jazzy Docker Image
# For use on Jetson Nano or Ubuntu 24.04 workstation

FROM ros:jazzy

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Basic tools
RUN apt-get update && apt-get install -y \
    nano \
    git \
    tmux \
    wget \
    curl \
    net-tools \
    iputils-ping \
    python3-pip \
    python3-colcon-common-extensions \
    python3-serial \
    && rm -rf /var/lib/apt/lists/*

# ROS2 packages
RUN apt-get update && apt-get install -y \
    ros-jazzy-joy \
    ros-jazzy-teleop-twist-keyboard \
    ros-jazzy-teleop-twist-joy \
    ros-jazzy-rviz2 \
    ros-jazzy-urdf \
    ros-jazzy-xacro \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-joint-state-publisher-gui \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-tf2 \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-nav2-bringup \
    ros-jazzy-navigation2 \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-robot-localization \
    ros-jazzy-imu-tools \
    && rm -rf /var/lib/apt/lists/*
    
    # Intel RealSense camera and depth-to-laserscan packages
    RUN apt-get update && apt-get install -y \
    ros-jazzy-realsense2-camera \
    ros-jazzy-realsense2-description \
    ros-jazzy-depthimage-to-laserscan \
    ros-jazzy-image-transport \
    ros-jazzy-image-transport-plugins \
    && rm -rf /var/lib/apt/lists/*
    
    # SLAM toolbox for mapping
    RUN apt-get update && apt-get install -y \
    ros-jazzy-slam-toolbox \
    && rm -rf /var/lib/apt/lists/*
    
    # RTAB-Map for visual SLAM
    RUN apt-get update && apt-get install -y \
    ros-jazzy-rtabmap \
    ros-jazzy-rtabmap-ros \
    ros-jazzy-rtabmap-sync \
    ros-jazzy-rtabmap-slam \
    ros-jazzy-rtabmap-viz \
    ros-jazzy-rtabmap-conversions \
    ros-jazzy-rqt-image-view \
    && rm -rf /var/lib/apt/lists/*
    
    # URDF tools
    RUN apt-get update && apt-get install -y \
    liburdfdom-tools \
    xterm \
    && rm -rf /var/lib/apt/lists/*
RUN pip install sparkfun-qwiic-icm20948 --break-system-packages

# Python libraries for robotic arm control (PCA9685 PWM driver)
# Jetson.GPIO is required for Blinka to access Jetson Nano's I2C pins
RUN pip install Jetson.GPIO adafruit-circuitpython-pca9685 --break-system-packages

# MCP server — lets Claude Code talk directly to this robot's ROS2 environment
RUN pip install mcp --break-system-packages

# Enable colored terminal prompt
RUN sed -i 's/^#force_color_prompt=yes/force_color_prompt=yes/' ~/.bashrc

# Add ROS2 sourcing to bashrc
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc
RUN echo "# Source workspace if built" >> ~/.bashrc
RUN echo "if [ -f ~/mark_five_amr/install/setup.bash ]; then source ~/mark_five_amr/install/setup.bash; fi" >> ~/.bashrc

# Add colored ls and grep aliases
RUN echo "alias ls='ls --color=auto'" >> ~/.bashrc
RUN echo "alias grep='grep --color=auto'" >> ~/.bashrc

# Colcon build defaults
RUN mkdir -p ~/.colcon && \
    echo -e "build:\n  symlink-install: true" > ~/.colcon/defaults.yaml

ENV MARKY_ROOT="/root/mark_five_amr/"

WORKDIR /root/mark_five_amr

# ROS2 Distributed networking
ENV ROS_DOMAIN_ID=5
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ENV ROS_STATIC_PEERS="192.168.12.124;192.168.12.249"
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

HEALTHCHECK --interval=5m --timeout=3s CMD echo "Mark Five: I'm alive!" || exit 1
CMD ["/bin/bash"]
