<?xml version="1.0"?>
<robot name="mark_five_robot">

  <!--
    Mark Five AMR - IKEA RÅSKOG Cart Platform

    Platform: IKEA RÅSKOG utility cart (350mm × 250mm base, ~880mm tall, 3-tier wire frame)
    Drive:    2x center-mounted 70mm wheels, differential drive (Sabertooth 2x12 + encoders)
    Support:  4x passive corner casters (~20mm radius)

    Key dimensions:
      Wheel diameter:  ~73mm (circumference 230mm measured → radius 36.6mm)
      Wheel base:      360mm center-to-center (left/right)
      Cart footprint:  350mm (Y, left/right) × 250mm (X, front/back)
      Shelf heights from ground:  135mm (bottom, measured), 380mm (middle, estimated), 640mm (top, estimated)
      Total height:    ~880mm (top of handle)

    Coordinate System (REP 103):
      X: Forward (along 250mm cart depth, away from handle)
      Y: Left    (along 350mm cart width)
      Z: Up
      base_footprint: on ground, center between drive wheels
      base_link:      at drive wheel axle height (36.6mm above ground)
  -->

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0366" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK (at wheel axle height) ==================== -->
  <link name="base_link">
    <inertial>
      <mass value="8.0"/>
      <!-- CG estimate: mid-height of loaded cart -->
      <origin xyz="0 0 0.310" rpy="0 0 0"/>
      <inertia ixx="0.50" ixy="0.0" ixz="0.0" iyy="0.50" iyz="0.0" izz="0.10"/>
    </inertial>
  </link>

  <!-- ==================== DRIVE WHEELS ==================== -->

  <!-- Left wheel (+Y side) -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0366" length="0.030"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
    <!-- Hub cap -->
    <visual>
      <origin xyz="0 0.016 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.002"/>
      </geometry>
      <material name="hub_silver">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0366" length="0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.180 0" rpy="0 0 0"/>
  </joint>

  <!-- Right wheel (-Y side) -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0366" length="0.030"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
    <!-- Hub cap -->
    <visual>
      <origin xyz="0 -0.016 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.002"/>
      </geometry>
      <material name="hub_silver">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0366" length="0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.180 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== MOTOR BODIES (visual only) ==================== -->
  <!-- Motors hang inside the frame, wheels protrude outside the rail -->

  <link name="left_motor_link">
    <!-- Motor cylinder -->
    <visual>
      <origin xyz="0 -0.012 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.045"/>
      </geometry>
      <material name="motor_silver">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
    <!-- Gearbox -->
    <visual>
      <origin xyz="0 -0.040 0" rpy="1.5708 0 0"/>
      <geometry>
        <box size="0.024 0.024 0.024"/>
      </geometry>
      <material name="gearbox_dark">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <!-- Drop arm (connects motor clamp on frame rail down to motor) -->
    <visual>
      <origin xyz="0 -0.025 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.040"/>
      </geometry>
      <material name="motor_silver">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="left_motor_joint" type="fixed">
    <parent link="left_wheel"/>
    <child link="left_motor_link"/>
    <origin xyz="0 -0.030 0" rpy="0 0 0"/>
  </joint>

  <link name="right_motor_link">
    <visual>
      <origin xyz="0 0.012 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.045"/>
      </geometry>
      <material name="motor_silver">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0.040 0" rpy="1.5708 0 0"/>
      <geometry>
        <box size="0.024 0.024 0.024"/>
      </geometry>
      <material name="gearbox_dark">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0.025 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.040"/>
      </geometry>
      <material name="motor_silver">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="right_motor_joint" type="fixed">
    <parent link="right_wheel"/>
    <child link="right_motor_link"/>
    <origin xyz="0 0.030 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CORNER CASTERS ==================== -->
  <!-- 4 passive casters, ~20mm radius, at cart corners -->
  <!-- Caster center Z relative to base_link: 20mm - 35mm = -15mm  -->
  <!-- Cart corners at (±0.110, ±0.155) — slightly inset from outer rail -->

  <link name="caster_fl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="caster_gray"><color rgba="0.50 0.50 0.50 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>
  <joint name="caster_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_fl"/>
    <origin xyz="0.110 0.155 -0.0166" rpy="0 0 0"/>
  </joint>

  <link name="caster_fr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="caster_gray"><color rgba="0.50 0.50 0.50 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>
  <joint name="caster_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_fr"/>
    <origin xyz="0.110 -0.155 -0.0166" rpy="0 0 0"/>
  </joint>

  <link name="caster_rl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="caster_gray"><color rgba="0.50 0.50 0.50 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>
  <joint name="caster_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rl"/>
    <origin xyz="-0.110 0.155 -0.0166" rpy="0 0 0"/>
  </joint>

  <link name="caster_rr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="caster_gray"><color rgba="0.50 0.50 0.50 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>
  <joint name="caster_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rr"/>
    <origin xyz="-0.110 -0.155 -0.0166" rpy="0 0 0"/>
  </joint>

  <!-- ==================== RÅSKOG CART FRAME ==================== -->
  <!--
    All visual geometry for the cart body lives in cart_frame_link.

    Heights relative to base_link (base_link is 35mm above ground):
      Uprights:     center at Z=+0.405m  (span: ground → 880mm, length 0.880m)
      Bottom shelf: Z=+0.030m  (65mm from ground)
      Middle shelf: Z=+0.345m  (380mm from ground)
      Top shelf:    Z=+0.605m  (640mm from ground)
      Handle rail:  Z=+0.845m  (880mm from ground)

    Upright positions (inset slightly from cart outer edge):
      (±0.110, ±0.160) from center
  -->

  <link name="cart_frame_link">

    <!-- === 4 corner vertical uprights (~16mm steel rod) === -->
    <visual>  <!-- front-left -->
      <origin xyz="0.110 0.160 0.405" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.880"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>  <!-- front-right -->
      <origin xyz="0.110 -0.160 0.405" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.880"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>  <!-- rear-left -->
      <origin xyz="-0.110 0.160 0.405" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.880"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>  <!-- rear-right -->
      <origin xyz="-0.110 -0.160 0.405" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.880"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>

    <!-- === Bottom shelf basket (135mm from ground, measured) === -->
    <visual>
      <origin xyz="0 0 0.100" rpy="0 0 0"/>
      <geometry><box size="0.230 0.330 0.003"/></geometry>
      <material name="shelf_white"><color rgba="0.95 0.95 0.95 0.85"/></material>
    </visual>
    <!-- Bottom shelf perimeter wire -->
    <visual>
      <origin xyz="0.115 0 0.103" rpy="0 0 0"/>
      <geometry><box size="0.003 0.330 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="-0.115 0 0.103" rpy="0 0 0"/>
      <geometry><box size="0.003 0.330 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.165 0.103" rpy="0 0 0"/>
      <geometry><box size="0.230 0.003 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 -0.165 0.103" rpy="0 0 0"/>
      <geometry><box size="0.230 0.003 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>

    <!-- === Middle shelf basket (380mm from ground) === -->
    <visual>
      <origin xyz="0 0 0.345" rpy="0 0 0"/>
      <geometry><box size="0.230 0.330 0.003"/></geometry>
      <material name="shelf_white"><color rgba="0.95 0.95 0.95 0.85"/></material>
    </visual>
    <!-- Middle shelf perimeter wire -->
    <visual>
      <origin xyz="0.115 0 0.348" rpy="0 0 0"/>
      <geometry><box size="0.003 0.330 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="-0.115 0 0.348" rpy="0 0 0"/>
      <geometry><box size="0.003 0.330 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.165 0.348" rpy="0 0 0"/>
      <geometry><box size="0.230 0.003 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 -0.165 0.348" rpy="0 0 0"/>
      <geometry><box size="0.230 0.003 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>

    <!-- === Top shelf basket (640mm from ground) === -->
    <visual>
      <origin xyz="0 0 0.605" rpy="0 0 0"/>
      <geometry><box size="0.230 0.330 0.003"/></geometry>
      <material name="shelf_white"><color rgba="0.95 0.95 0.95 0.85"/></material>
    </visual>
    <!-- Top shelf perimeter wire -->
    <visual>
      <origin xyz="0.115 0 0.608" rpy="0 0 0"/>
      <geometry><box size="0.003 0.330 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="-0.115 0 0.608" rpy="0 0 0"/>
      <geometry><box size="0.003 0.330 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.165 0.608" rpy="0 0 0"/>
      <geometry><box size="0.230 0.003 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 -0.165 0.608" rpy="0 0 0"/>
      <geometry><box size="0.230 0.003 0.006"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>

    <!-- === Handle rail at top (880mm from ground = 845mm above base_link) === -->
    <!-- Horizontal rail along Y axis -->
    <visual>
      <origin xyz="-0.110 0 0.845" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.330"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <!-- Handle curves (simplified as short cylinders) -->
    <visual>
      <origin xyz="-0.095 0.155 0.835" rpy="0 0.785 0"/>
      <geometry><cylinder radius="0.008" length="0.022"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="-0.095 -0.155 0.835" rpy="0 0.785 0"/>
      <geometry><cylinder radius="0.008" length="0.022"/></geometry>
      <material name="steel_chrome"><color rgba="0.80 0.80 0.82 1.0"/></material>
    </visual>

    <!-- === Bounding box collision (whole cart body) === -->
    <collision>
      <origin xyz="0 0 0.405" rpy="0 0 0"/>
      <geometry>
        <box size="0.250 0.350 0.880"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="3.5"/>
      <origin xyz="0 0 0.405" rpy="0 0 0"/>
      <inertia ixx="0.30" ixy="0.0" ixz="0.0" iyy="0.30" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="cart_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cart_frame_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== JETSON NANO (middle shelf) ==================== -->
  <!--
    Middle shelf surface: 345mm above base_link.
    Jetson sits on shelf: Z = 0.345 + 0.003 (shelf) + 0.0225 (half box) = 0.3705
  -->
  <link name="jetson_nano_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.100 0.080 0.045"/></geometry>
      <material name="jetson_case"><color rgba="0.25 0.25 0.25 1.0"/></material>
    </visual>
    <!-- Heatsink fins -->
    <visual>
      <origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.090 0.070 0.008"/></geometry>
      <material name="heatsink"><color rgba="0.20 0.20 0.20 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.100 0.080 0.050"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="jetson_nano_joint" type="fixed">
    <parent link="cart_frame_link"/>
    <child link="jetson_nano_link"/>
    <origin xyz="-0.030 0.040 0.371" rpy="0 0 0"/>
  </joint>

  <!-- WiFi antennas on Jetson -->
  <link name="antenna_left_link">
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry><cylinder radius="0.006" length="0.016"/></geometry>
      <material name="antenna_base"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.090" rpy="0 0.18 0"/>
      <geometry><cylinder radius="0.004" length="0.150"/></geometry>
      <material name="antenna_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0.014 0 0.163" rpy="0 0.18 0"/>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="antenna_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
  </link>
  <joint name="antenna_left_joint" type="fixed">
    <parent link="jetson_nano_link"/>
    <child link="antenna_left_link"/>
    <origin xyz="-0.040 0.025 0.030" rpy="0 0 0"/>
  </joint>

  <link name="antenna_right_link">
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry><cylinder radius="0.006" length="0.016"/></geometry>
      <material name="antenna_base"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.090" rpy="0 0.12 0"/>
      <geometry><cylinder radius="0.004" length="0.150"/></geometry>
      <material name="antenna_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0.009 0 0.163" rpy="0 0.12 0"/>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="antenna_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
  </link>
  <joint name="antenna_right_joint" type="fixed">
    <parent link="jetson_nano_link"/>
    <child link="antenna_right_link"/>
    <origin xyz="-0.040 -0.025 0.030" rpy="0 0 0"/>
  </joint>

  <!-- ==================== ARDUINO MEGA (middle shelf) ==================== -->
  <link name="arduino_mega_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.101 0.053 0.002"/></geometry>
      <material name="arduino_blue"><color rgba="0.0 0.35 0.55 1.0"/></material>
    </visual>
    <visual>  <!-- USB port -->
      <origin xyz="0.045 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.012 0.010 0.008"/></geometry>
      <material name="usb_silver"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.101 0.053 0.015"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="arduino_mega_joint" type="fixed">
    <parent link="cart_frame_link"/>
    <child link="arduino_mega_link"/>
    <origin xyz="0.040 -0.060 0.349" rpy="0 0 0"/>
  </joint>

  <!-- ==================== ICM-20948 9-DOF IMU ==================== -->
  <!--
    Mounted on the BOTTOM shelf, centered left-right (Y=0).
      Bottom shelf floor from ground: 135mm (measured)
      Bottom shelf surface above cart_frame_link: 135mm - 35mm + 1.5mm = 101.5mm
      Z: shelf surface (0.1015m) + 50mm above shelf floor = 0.152m
      X: front wall at x=+0.115m, inset 19mm → 0.096m
      Y: 0.0 (centered)

    Connection (Jetson Nano I2C Bus 1):
      VIN → 3.3V (Pin 1)   GND → GND (Pin 6)
      SDA → Pin 3           SCL → Pin 5
    I2C Address: 0x68
  -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.016 0.026 0.003"/></geometry>
      <material name="imu_purple"><color rgba="0.4 0.2 0.6 1.0"/></material>
    </visual>
    <!-- Chip indicator -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><box size="0.005 0.005 0.001"/></geometry>
      <material name="chip_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.016 0.026 0.003"/></geometry>
    </collision>
    <inertial>
      <mass value="0.003"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="cart_frame_link"/>
    <child link="imu_link"/>
    <origin xyz="0.096 0.0 0.152" rpy="0 0 0"/>
  </joint>

  <!-- ==================== INTEL REALSENSE D435 CAMERA ==================== -->
  <!--
    Clamped to the front horizontal cross-rail, facing forward, centered left-right.

    Height: 389mm from ground (tape measured) → 389 - 35 (base_link) = 354mm above cart_frame_link.

    X: front rail at x=0.115m + ~5mm camera body protrusion = 0.120m
    Y: 0.0 (centered on rail)
    Z: 0.354m above cart_frame_link
    RPY: 0 0 0 (horizontal, facing +X / forward)
  -->
  <link name="camera_link">
    <!-- D435 body: 90mm wide × 25mm tall × 25mm deep -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="camera_body"><color rgba="0.15 0.15 0.15 1.0"/></material>
    </visual>
    <!-- Front glass / lens array -->
    <visual>
      <origin xyz="0.013 0 0" rpy="0 0 0"/>
      <geometry><box size="0.001 0.086 0.020"/></geometry>
      <material name="camera_lens"><color rgba="0.05 0.05 0.08 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="cart_frame_link"/>
    <child link="camera_link"/>
    <origin xyz="0.120 0.0 0.354" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ==================== LDROBOT LD19 LIDAR ==================== -->
  <!--
    Mounted at the front of the cart, below the camera. Frame name must match
    the ldlidar driver's frame_id (base_laser).

    Height: scan plane 225mm from ground (tape measured) → 225 - 36.6 (base_link) = 188mm above cart_frame_link.
    X: directly under the camera on the front rail = 0.120m (measure to the rotation axis to refine)
    Yaw: 0 assumes the LD19 cable/connector exits toward the rear (+X = forward).
         Verify against a known wall in RViz and correct the yaw here if rotated.
  -->
  <link name="base_laser">
    <!-- LD19 body: Ø38.6mm × 34.8mm; link origin at the scan plane (near top of unit) -->
    <visual>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0193" length="0.0348"/></geometry>
      <material name="lidar_body"><color rgba="0.2 0.2 0.25 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0193" length="0.0348"/></geometry>
    </collision>
    <inertial>
      <mass value="0.045"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="cart_frame_link"/>
    <child link="base_laser"/>
    <origin xyz="0.120 0.0 0.188" rpy="0 0 0"/>
  </joint>

</robot>
