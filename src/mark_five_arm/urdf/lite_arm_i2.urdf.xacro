<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lite_arm_i2">

  <!-- ========================================= -->
  <!-- URDF for Lite Arm i2 (3-DOF + optional gripper) -->
  <!-- ========================================= -->
  <!-- Based on Thingiverse thing:480446         -->
  <!-- Design: Parallel linkage (like ABB IRB-660) -->
  <!--                                           -->
  <!-- NOTE: The actual arm uses a 4-bar parallel -->
  <!-- linkage mechanism. This URDF simplifies it -->
  <!-- to a serial chain for basic visualization. -->
  <!-- For accurate kinematics/MoveIt2, the       -->
  <!-- parallel linkage would need to be modeled. -->
  <!--                                           -->
  <!-- Dimensions extracted from STL files:      -->
  <!-- - Upper arm (20_21B.stl): 230mm           -->
  <!-- - Forearm (15C.stl): 180mm                -->
  <!-- ========================================= -->

  <!-- Arm dimensions (extracted from STL files - Lite Arm i2) -->
  <!-- Base: 1B.stl = 104mm diameter, 6B.stl ~90mm -->
  <xacro:property name="base_height" value="0.050" />       <!-- 50mm (estimated from assembly) -->
  <xacro:property name="base_radius" value="0.052" />       <!-- 52mm (half of 104mm base plate) -->

  <!-- Upper arm: 20_21B.stl = 230.1mm -->
  <xacro:property name="upper_arm_length" value="0.2301" /> <!-- 230mm from STL -->
  <xacro:property name="upper_arm_width" value="0.031" />   <!-- 31mm from STL -->
  <xacro:property name="upper_arm_height" value="0.006" />  <!-- 6mm from STL -->

  <!-- Forearm: 15C.stl = 180.3mm -->
  <xacro:property name="forearm_length" value="0.1803" />   <!-- 180mm from STL -->
  <xacro:property name="forearm_width" value="0.018" />     <!-- 18mm from STL -->
  <xacro:property name="forearm_height" value="0.006" />    <!-- 6mm from STL -->

  <xacro:property name="gripper_length" value="0.080" />    <!-- 80mm -->
  <xacro:property name="gripper_finger_length" value="0.050" />  <!-- 50mm -->

  <!-- Joint limits (measure actual servo range) -->
  <xacro:property name="base_lower" value="${-pi/2}" />     <!-- -90° -->
  <xacro:property name="base_upper" value="${pi/2}" />      <!-- +90° -->

  <xacro:property name="shoulder_lower" value="${-pi/4}" /> <!-- -45° -->
  <xacro:property name="shoulder_upper" value="${pi/2}" />  <!-- +90° -->

  <xacro:property name="elbow_lower" value="${-pi/2}" />    <!-- -90° -->
  <xacro:property name="elbow_upper" value="${pi/2}" />     <!-- +90° -->

  <xacro:property name="gripper_lower" value="0.0" />       <!-- Closed -->
  <xacro:property name="gripper_upper" value="0.785" />     <!-- Open (45°) -->

  <!-- ========================================= -->
  <!-- Material Definitions                      -->
  <!-- ========================================= -->

  <material name="white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ========================================= -->
  <!-- Base Link (Fixed to Ground)               -->
  <!-- ========================================= -->

  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ========================================= -->
  <!-- Joint 1: Base Rotation (Servo 1)          -->
  <!-- Rotates around Z axis (vertical)          -->
  <!-- ========================================= -->

  <link name="base_rotate_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base" type="revolute">
    <parent link="arm_base_link"/>
    <child link="base_rotate_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${base_lower}" upper="${base_upper}"
           effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 2: Shoulder (Servo 2)               -->
  <!-- Rotates around Y axis (horizontal)        -->
  <!-- ========================================= -->

  <link name="upper_arm_link">
    <visual>
      <origin xyz="${upper_arm_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_arm_length} ${upper_arm_width} ${upper_arm_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${upper_arm_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_arm_length} ${upper_arm_width} ${upper_arm_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${upper_arm_length/2} 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_rotate_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${shoulder_lower}" upper="${shoulder_upper}"
           effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 3: Elbow (Servo 3)                  -->
  <!-- Rotates around Y axis (horizontal)        -->
  <!-- ========================================= -->

  <link name="forearm_link">
    <visual>
      <origin xyz="${forearm_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${forearm_length} ${forearm_width} ${forearm_height}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="${forearm_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${forearm_length} ${forearm_width} ${forearm_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${forearm_length/2} 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0008" iyz="0.0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="${upper_arm_length} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${elbow_lower}" upper="${elbow_upper}"
           effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 4: Gripper (Servo 4)                -->
  <!-- Simple revolute joint for open/close      -->
  <!-- ========================================= -->

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper" type="revolute">
    <parent link="forearm_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="${forearm_length} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${gripper_lower}" upper="${gripper_upper}"
           effort="5.0" velocity="1.0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- ========================================= -->
  <!-- Gripper Fingers (Visual/Collision)        -->
  <!-- ========================================= -->

  <!-- Left finger -->
  <link name="gripper_left_finger">
    <visual>
      <origin xyz="${gripper_finger_length/2} 0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="${gripper_finger_length} 0.01 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="${gripper_finger_length/2} 0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="${gripper_finger_length} 0.01 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${gripper_finger_length/2} 0.02 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="gripper_left_finger_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Right finger -->
  <link name="gripper_right_finger">
    <visual>
      <origin xyz="${gripper_finger_length/2} -0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="${gripper_finger_length} 0.01 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="${gripper_finger_length/2} -0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="${gripper_finger_length} 0.01 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${gripper_finger_length/2} -0.02 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="gripper_right_finger_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================= -->
  <!-- End Effector Frame                        -->
  <!-- ========================================= -->

  <link name="end_effector_link"/>

  <joint name="end_effector_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="end_effector_link"/>
    <origin xyz="${0.04 + gripper_finger_length} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================= -->
  <!-- Virtual Link for RViz Fixed Frame         -->
  <!-- ========================================= -->

  <!-- This link serves as the root of the kinematic chain -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
