<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mark_five_arm">

  <!-- ========================================= -->
  <!-- URDF Properties - Customize These!        -->
  <!-- ========================================= -->
  <!-- Measure your actual arm and update these values -->

  <xacro:property name="base_height" value="0.05" />
  <xacro:property name="base_radius" value="0.04" />

  <xacro:property name="shoulder_length" value="0.15" />
  <xacro:property name="shoulder_radius" value="0.02" />

  <xacro:property name="elbow_length" value="0.15" />
  <xacro:property name="elbow_radius" value="0.015" />

  <xacro:property name="wrist_length" value="0.08" />
  <xacro:property name="wrist_radius" value="0.01" />

  <xacro:property name="gripper_length" value="0.06" />
  <xacro:property name="gripper_width" value="0.03" />

  <!-- Joint limits (match config/arm_params.yaml) -->
  <xacro:property name="base_limit" value="1.5708" />        <!-- ±90° -->
  <xacro:property name="shoulder_limit" value="1.5708" />    <!-- ±90° -->
  <xacro:property name="elbow_limit" value="1.5708" />       <!-- ±90° -->
  <xacro:property name="wrist_pitch_limit" value="1.5708" /> <!-- ±90° -->
  <xacro:property name="wrist_roll_limit" value="1.5708" />  <!-- ±90° -->
  <xacro:property name="gripper_limit" value="1.0472" />     <!-- 60° -->

  <!-- ========================================= -->
  <!-- Material Definitions                      -->
  <!-- ========================================= -->

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <!-- ========================================= -->
  <!-- Macro for Cylinder Links                  -->
  <!-- ========================================= -->

  <xacro:macro name="cylinder_link" params="name length radius material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${length}" radius="${radius}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${length}" radius="${radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ========================================= -->
  <!-- Base Link (Fixed to Ground)               -->
  <!-- ========================================= -->

  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ========================================= -->
  <!-- Joint 1: Base Rotation (around Z axis)    -->
  <!-- ========================================= -->

  <link name="base_rotate_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.04"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base" type="revolute">
    <parent link="arm_base_link"/>
    <child link="base_rotate_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-base_limit}" upper="${base_limit}" effort="10" velocity="1.0"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 2: Shoulder (around Y axis)         -->
  <!-- ========================================= -->

  <xacro:cylinder_link name="shoulder_link"
                       length="${shoulder_length}"
                       radius="${shoulder_radius}"
                       material="blue"/>

  <joint name="shoulder" type="revolute">
    <parent link="base_rotate_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-shoulder_limit}" upper="${shoulder_limit}" effort="10" velocity="1.0"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 3: Elbow (around Y axis)            -->
  <!-- ========================================= -->

  <xacro:cylinder_link name="elbow_link"
                       length="${elbow_length}"
                       radius="${elbow_radius}"
                       material="gray"/>

  <joint name="elbow" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 ${shoulder_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-elbow_limit}" upper="${elbow_limit}" effort="10" velocity="1.0"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 4: Wrist Pitch (around Y axis)      -->
  <!-- ========================================= -->

  <xacro:cylinder_link name="wrist_pitch_link"
                       length="${wrist_length}"
                       radius="${wrist_radius}"
                       material="orange"/>

  <joint name="wrist_pitch" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0 ${elbow_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-wrist_pitch_limit}" upper="${wrist_pitch_limit}" effort="5" velocity="1.0"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 5: Wrist Roll (around Z axis)       -->
  <!-- ========================================= -->

  <link name="wrist_roll_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 ${wrist_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-wrist_roll_limit}" upper="${wrist_roll_limit}" effort="5" velocity="1.0"/>
  </joint>

  <!-- ========================================= -->
  <!-- Joint 6: Gripper (prismatic approximation)-->
  <!-- ========================================= -->

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper" type="revolute">
    <parent link="wrist_roll_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="${gripper_limit}" effort="5" velocity="1.0"/>
  </joint>

  <!-- Gripper fingers (visual only) -->
  <link name="gripper_left_finger">
    <visual>
      <origin xyz="0 ${gripper_width/2} ${gripper_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.005 ${gripper_length}"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <link name="gripper_right_finger">
    <visual>
      <origin xyz="0 ${-gripper_width/2} ${gripper_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.005 ${gripper_length}"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="gripper_left_finger_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_right_finger_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- End effector frame -->
  <link name="end_effector_link"/>

  <joint name="end_effector_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 ${0.04 + gripper_length}" rpy="0 0 0"/>
  </joint>

</robot>
