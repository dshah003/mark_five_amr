<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mark_five_safety</name>
  <version>0.1.0</version>
  <description>Safety watchdog for Mark Five AMR: last-hop velocity gate (/cmd_vel_safe -> /cmd_vel_gated) with heartbeat trip (S2) and velocity re-cap (S4)</description>
  <maintainer email="darshan@example.com">Darshan Shah</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>action_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
