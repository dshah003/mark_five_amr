<launch>
  <!--
    Mark Five AMR - Workstation Launch

    For distributed ROS setup. Run this on the GPU workstation.
    This machine runs roscore and heavy processing nodes.

    Prerequisites:
      1. Source environment: source scripts/env_workstation.sh
      2. Start roscore: roscore
      3. Ensure robot is connected: rostopic list should show /odom, /left_ticks, etc.

    Nodes launched:
      - teleop_twist_keyboard (keyboard control)
      - rviz (visualization)

    Future additions (Phase 6+):
      - rtabmap (SLAM)
      - move_base (navigation)
      - darknet_ros (object detection)
      - MoveIt (arm planning)

    Usage:
      roslaunch mark_five_bot workstation.launch
      roslaunch mark_five_bot workstation.launch rviz:=false
      roslaunch mark_five_bot workstation.launch teleop:=joy
  -->

  <!-- Arguments -->
  <arg name="rviz" default="true" doc="Launch RViz visualization"/>
  <arg name="teleop" default="keyboard" doc="Teleop type: keyboard, joy, or none"/>
  <arg name="rviz_config" default="$(find mark_five_description)/rviz/display.rviz" doc="RViz config file"/>

  <!-- ==================== ROBOT MODEL ==================== -->

  <!-- Load robot URDF (needed for RViz even though robot publishes TF) -->
  <param name="robot_description" textfile="$(find mark_five_description)/urdf/robot.urdf"/>

  <!-- ==================== TELEOPERATION ==================== -->

  <!-- Keyboard teleop -->
  <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py"
        name="teleop_twist_keyboard" output="screen"
        if="$(eval teleop == 'keyboard')">
    <param name="speed" value="0.3"/>
    <param name="turn" value="0.5"/>
  </node>

  <!-- Joystick teleop -->
  <group if="$(eval teleop == 'joy')">
    <node pkg="joy" type="joy_node" name="joy_node">
      <param name="dev" value="/dev/input/js0"/>
      <param name="deadzone" value="0.1"/>
    </node>
    <node pkg="teleop_twist_joy" type="teleop_node" name="teleop_twist_joy">
      <param name="enable_button" value="4"/>
      <param name="axis_linear" value="1"/>
      <param name="axis_angular" value="0"/>
      <param name="scale_linear" value="0.3"/>
      <param name="scale_angular" value="0.5"/>
    </node>
  </group>

  <!-- ==================== VISUALIZATION ==================== -->

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"
        if="$(arg rviz)"/>

  <!-- ==================== IMAGE TRANSPORT (for viewing camera) ==================== -->

  <!--
    Republish compressed images for bandwidth optimization.
    Robot publishes compressed, workstation decompresses for display.
    Uncomment when camera is active.
  -->
  <!--
  <node pkg="image_transport" type="republish" name="rgb_decompress"
        args="compressed raw">
    <remap from="in" to="/camera/color/image_raw"/>
    <remap from="out" to="/camera/color/image_decompressed"/>
  </node>
  -->

</launch>
